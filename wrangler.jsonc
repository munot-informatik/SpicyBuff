{
  // SpicyBuff is a static site: this Worker only serves the built files in dist/.
  // No server code runs, nothing is logged or stored by the app.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spicybuff",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false }
}
