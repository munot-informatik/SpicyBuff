{
  "name": "spicybuff",
  "private": true,
  "version": "0.1.0",
  "description": "SpicyBuff – on-device, research-informed brain exercises for the feeling you have right now. Informational only, not treatment.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
