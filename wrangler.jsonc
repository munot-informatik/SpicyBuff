{
  // SpicyBuff is a static site: this Worker only serves the built files in dist/.
  // No server code runs, nothing is logged or stored by the app.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spicybuff",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "spicybuff.munot-informatik.ch", "custom_domain": true }],
  // Only the custom domain serves the app; the *.workers.dev address is off.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
